{
  "version": 2,
  "installCommand": "cd client && npm ci",
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ai-multi-tool-app.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://ai-multi-tool-app.onrender.com/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
